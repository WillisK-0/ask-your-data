{
  "name": "ask-your-data",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An MCP connector and chat UI that let Claude answer questions from a real database and a folder of docs. Zero native dependencies.",
  "scripts": {
    "seed": "tsx src/seed.ts",
    "mcp": "tsx src/mcp.ts",
    "serve": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/smoke.ts",
    "smoke:ui": "tsx src/smoke-ui.ts",
    "demo-data": "tsx src/demo-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.7"
