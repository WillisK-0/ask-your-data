{
  "name": "@willisk-0/ask-your-data",
  "version": "0.3.0",
  "type": "module",
  "description": "MCP connector that lets Claude answer questions from a SQLite database and a folder of docs, with interactive panels in Claude Desktop (table, chart, policy answer, approvals, ticket form).",
  "scripts": {
    "seed": "tsx src/seed.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/ui && cp src/ui/*.html dist/ui/ && cp src/query-child.mjs dist/",
    "prepublishOnly": "npm run seed && npm run build",
    "mcp": "tsx src/mcp.ts",
    "serve": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/smoke.ts",
    "smoke:ui": "tsx src/smoke-ui.ts",
    "demo-data": "tsx src/demo-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.7"
  },
  "mcpName": "io.github.willisk-0/ask-your-data",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WillisK-0/ask-your-data.git"
  },
  "homepage": "https://bennettworks.io/demo/",
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "claude-desktop",
    "mcp-apps",
    "sqlite",
    "connector"
  ],
  "bin": {
    "ask-your-data-mcp": "bin/mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "data/sample.db",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  }
}
